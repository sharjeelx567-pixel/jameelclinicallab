# ─── JAMEEL CLINICAL LABORATORY — Frontend ──────────────────────────────────
# Only PUBLIC values belong here. Never put service-account keys or secrets in
# the frontend — every NEXT_PUBLIC_ variable is shipped to the browser.

# Backend REST API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Auth mode — must match the backend:
#   firebase — sign in with Firebase Authentication (production)
#   dev      — DEVELOPMENT ONLY demo-user picker (backend must run AUTH_MODE=dev)
NEXT_PUBLIC_AUTH_MODE=firebase

# Firebase Web SDK config (public identifiers — Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: use the Auth emulator locally
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099

# Images (logo, gallery, staff/doctor photos) are uploaded THROUGH THE BACKEND to
# Cloudinary. No Cloudinary keys belong here — the API secret stays in backend/.env
# and the browser only receives the public, optimised image URLs.
