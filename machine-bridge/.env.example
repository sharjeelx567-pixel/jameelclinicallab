# ─── JAMEEL CLINICAL LABORATORY — Machine bridge ────────────────────────────
# Runs on the laboratory PC physically connected to the analyzer(s).

# Backend API base URL (HTTPS in production)
BACKEND_URL=http://localhost:4000/api/v1

# Bridge identity. The backend stores only sha256(BRIDGE_TOKEN) in BRIDGE_TOKEN_HASHES.
BRIDGE_ID=lab-pc-1
BRIDGE_TOKEN=

# Analyzer definitions (see bridge.config.example.json)
BRIDGE_CONFIG=./bridge.config.json

# Local durable queue directory
QUEUE_DIR=./data/queue

# Local health/status endpoint — bound to localhost only
HEALTH_PORT=4100
