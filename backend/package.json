{
  "name": "jcl-backend",
  "version": "0.1.0",
  "private": true,
  "description": "JAMEEL CLINICAL LABORATORY — LIS/LIMS REST API (NestJS + Firebase Admin)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "bootstrap:admin": "ts-node-dev --transpile-only src/scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:e2e:firestore": "cross-env E2E_DATA_BACKEND=firestore FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 jest --config test/jest-e2e.json --runInBand",
    "test:all": "npm run test && npm run test:e2e",
    "test:cloudinary": "ts-node-dev --transpile-only src/scripts/cloudinary-smoke.ts",
    "import:rates": "ts-node-dev --transpile-only src/scripts/import-rate-list.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "cloudinary": "^2.11.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "pdfkit": "^0.17.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.30.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
