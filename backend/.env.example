# ─── JAMEEL CLINICAL LABORATORY — Backend environment ───────────────────────
# Copy to .env and fill in. NEVER commit .env or service-account files.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (the frontend URL).
CORS_ORIGINS=http://localhost:3000

# Data backend:
#   firestore — Cloud Firestore via Firebase Admin SDK (required in production)
#   memory    — DEVELOPMENT ONLY in-memory store. Data is lost on restart.
#               Refused when NODE_ENV=production.
DATA_BACKEND=firestore

# Auth mode:
#   firebase — verify Firebase ID tokens (required in production)
#   dev      — DEVELOPMENT ONLY. Accepts "Bearer dev:<uid>" for seeded dev users.
#              Refused when NODE_ENV=production.
AUTH_MODE=firebase

# Seed clearly-labelled DEMO users and catalog structure on startup (dev only).
SEED_DEMO_DATA=false

# ─── Firebase Admin (backend only) ──────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Option A: path to service-account JSON (kept OUTSIDE the repository)
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: inline credentials (escape newlines in the private key as \n)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option C (Vercel / no files): paste the WHOLE service-account JSON (or its base64) into one variable
FIREBASE_SERVICE_ACCOUNT=
# Use the local emulators instead of production Firebase (optional)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─── Machine bridge authentication ──────────────────────────────────────────
# Comma-separated "bridgeId:sha256(token)" pairs. Generate with:
#   node -e "const c=require('crypto');const t=c.randomBytes(32).toString('hex');console.log('token',t);console.log('hash',c.createHash('sha256').update(t).digest('hex'))"
BRIDGE_TOKEN_HASHES=

# Public report verification (QR code) base URL shown on printed reports
REPORT_VERIFY_BASE_URL=http://localhost:3000/verify

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=300

# Vercel Cron secret (enables GET /api/v1/inventory/expiry-scan for the daily expiry scan)
CRON_SECRET=

# ─── Cloudinary (non-sensitive images only) ─────────────────────────────────
# Console → Settings (gear) → API Keys. Backend only — NEVER put these in the
# frontend. Used for: lab logo, gallery, staff/doctor photos, website art.
# Patient documents and reports are never sent to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix to separate environments, e.g. jcl-dev (blank = root)
CLOUDINARY_FOLDER_PREFIX=
# Verify with a real upload + delete:  npm run test:cloudinary
